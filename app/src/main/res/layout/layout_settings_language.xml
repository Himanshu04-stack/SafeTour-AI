<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_grey"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/ivBackFromLanguage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_play"
            android:rotation="270"
            app:tint="@color/theme_icon_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="App Language"
            android:textColor="@color/theme_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="32dp"/>
    </LinearLayout>

    <RadioGroup
        android:id="@+id/rgLanguages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">

        <RadioButton
            android:id="@+id/rbLangEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="English"
            android:textColor="@color/theme_text_primary"
            android:textSize="18sp"
            android:paddingVertical="16dp"
            android:checked="true"
            android:buttonTint="@color/theme_icon_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/theme_divider" />

        <RadioButton
            android:id="@+id/rbLangSpanish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Español (Spanish)"
            android:textColor="@color/theme_text_primary"
            android:textSize="18sp"
            android:paddingVertical="16dp"
            android:buttonTint="@color/theme_icon_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/theme_divider" />

        <RadioButton
            android:id="@+id/rbLangFrench"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Français (French)"
            android:textColor="@color/theme_text_primary"
            android:textSize="18sp"
            android:paddingVertical="16dp"
            android:buttonTint="@color/theme_icon_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/theme_divider" />

        <RadioButton
            android:id="@+id/rbLangHindi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="हिंदी (Hindi)"
            android:textColor="@color/theme_text_primary"
            android:textSize="18sp"
            android:paddingVertical="16dp"
            android:buttonTint="@color/theme_icon_primary" />

    </RadioGroup>

</LinearLayout>
