<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_splash">

    <fragment
        android:id="@+id/navigation_splash"
        android:name="com.safetour.ai.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/navigation_login"
            app:popUpTo="@id/navigation_splash"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/navigation_login"
        android:name="com.safetour.ai.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_login"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_login_to_setup"
            app:destination="@id/navigation_setup"
            app:popUpTo="@id/navigation_login"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.safetour.ai.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_explore"
        android:name="com.safetour.ai.ui.ExploreFragment"
        android:label="Explore"
        tools:layout="@layout/fragment_explore" />

    <fragment
        android:id="@+id/navigation_assistant"
        android:name="com.safetour.ai.ui.AssistantFragment"
        android:label="Assistant"
        tools:layout="@layout/fragment_assistant" />

    <fragment
        android:id="@+id/navigation_track"
        android:name="com.safetour.ai.ui.TrackFragment"
        android:label="Track"
        tools:layout="@layout/fragment_track" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.safetour.ai.ui.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/navigation_setup"
        android:name="com.safetour.ai.ui.SetupFragment"
        android:label="Setup"
        tools:layout="@layout/fragment_setup">
        <action
            android:id="@+id/action_setup_to_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_setup"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

</navigation>
