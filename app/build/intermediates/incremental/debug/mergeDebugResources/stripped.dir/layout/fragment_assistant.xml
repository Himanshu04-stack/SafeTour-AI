<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/theme_primary_bg">

    <!-- Nexus AI Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="56dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nexus AI"
                android:textColor="@color/theme_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Now "
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="12sp" />

                <!-- Green Dot -->
                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="2dp"
                    android:src="@drawable/bg_circle_premium"
                    app:tint="#4CAF50" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Online"
                    android:textColor="#4CAF50"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Side Icons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivAssistantLogo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_assistant"
                app:tint="@color/theme_icon_primary"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/theme_icon_primary"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/theme_icon_primary" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <EditText
        android:id="@+id/etSearchChats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chat_input"
        android:hint="Search historical chats..."
        android:padding="12dp"
        android:textSize="14sp"
        android:visibility="gone"
        android:textColor="@color/theme_text_primary"
        app:layout_constraintTop_toBottomOf="@id/chatHeader" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etSearchChats" />

    <!-- Bottom Input Area Container -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/theme_primary_bg"
        android:paddingBottom="16dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Horizontally Scrollable Suggestion Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScamCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Scam Check"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#0A7AF5"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="0dp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHelp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help"
                    android:textColor="@color/theme_text_primary"
                    app:chipBackgroundColor="@color/theme_surface_premium"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/theme_divider_dark"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTranslate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Translate"
                    android:textColor="@color/theme_text_primary"
                    app:chipBackgroundColor="@color/theme_surface_premium"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/theme_divider_dark"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAnalyze"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analyze"
                    android:textColor="@color/theme_text_primary"
                    app:chipBackgroundColor="@color/theme_surface_premium"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/theme_divider_dark" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Pill Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_chat_input"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Message Nexus AI..."
                android:textColor="@color/theme_text_primary"
                android:textColorHint="#999999"
                android:textSize="16sp"
                android:inputType="textShortMessage" />

            <!-- Paperclip -->
            <ImageView
                android:id="@+id/ivPaperclip"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/theme_icon_primary"
                android:layout_marginEnd="8dp" />

            <!-- Prominent Blue Sparkle Button -->
            <FrameLayout
                android:id="@+id/flSparkleAction"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_premium"
                android:backgroundTint="#0A7AF5"
                android:layout_marginEnd="8dp">
                
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Microphone -->
            <ImageView
                android:id="@+id/ivMic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@color/theme_icon_primary"
                android:layout_marginEnd="8dp" />

            <!-- Send Button -->
            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/theme_icon_primary" />
        </LinearLayout>
    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DRAWER CONTENT -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/theme_primary_bg"
        android:orientation="vertical"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/btnNewConversation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:layout_margin="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_add"
                app:tint="#0A7AF5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="New Conversation"
                android:textColor="#0A7AF5"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EAEAEA" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewHistoryDrawer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="8dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
