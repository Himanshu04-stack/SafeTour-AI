<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:clipToPadding="false"
    android:paddingVertical="4dp"
    android:paddingHorizontal="16dp">

    <!-- Nexus AI Avatar Box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/theme_surface_secondary"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_nav_assistant"
            android:padding="4dp"
            app:tint="@color/theme_icon_primary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Upraised 3D Speech Bubble -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/theme_chat_bubble_ai"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.SafeTour.ChatAi"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="AI Response..."
            android:textColor="@color/theme_chat_text_ai"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
