<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact 1"
        android:textStyle="bold"
        android:textColor="#1F1F1F"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etContact1Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Name (e.g. Sarah Doe)"
        android:inputType="textPersonName"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etContact1Relation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Relationship (e.g. Wife)"
        android:inputType="text"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etContact1Phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone Number"
        android:inputType="phone"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAEAEA"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact 2"
        android:textStyle="bold"
        android:textColor="#1F1F1F"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etContact2Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Name (e.g. Mark Lee)"
        android:inputType="textPersonName"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etContact2Relation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Relationship (e.g. Brother)"
        android:inputType="text"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etContact2Phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone Number"
        android:inputType="phone"/>
</LinearLayout>
